APP_NAME=FrameNote API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/framenote
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_VIDEO_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
PUBLIC_API_BASE_URL=http://localhost:8000
VIDEO_URL_MAX_BYTES=2147483648
VIDEO_URL_TIMEOUT_SECONDS=900
MAX_UPLOAD_BYTES=2147483648
ALLOW_PRIVATE_VIDEO_URLS=false
VIDEO_CHAT_CONTEXT_CHARS=30000
VIDEO_CHAT_MAX_OUTPUT_TOKENS=500
VIDEO_CHAT_MONTHLY_TOKEN_BUDGET=2000000
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
LOCAL_UPLOAD_DIR=/data/framenote/uploads
LOCAL_PROCESSED_DIR=/data/framenote/processed
JWT_SECRET_KEY=dev-insecure-secret-change-me
LEGACY_HEADER_AUTH_ENABLED=true
# Production: ENVIRONMENT=production, LEGACY_HEADER_AUTH_ENABLED=false,
# and a unique JWT_SECRET_KEY with at least 32 characters. Configure a private R2 bucket.
# Replace DATABASE_URL with a managed PostgreSQL URL using a strong password and sslmode=require
# (or sslmode=verify-full with the provider's CA certificate). Run alembic upgrade head before startup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_SUCCESS_URL=http://localhost:3000/upgrade?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/upgrade?billing=cancel

# --- Social sign-in (optional; buttons only show on the login page for providers set here) ---
# FRONTEND_BASE_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
