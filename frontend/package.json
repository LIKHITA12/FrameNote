{
  "name": "framenote-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:stable": "NEXT_DISABLE_WEBPACK_CACHE=1 NEXT_DIST_DIR=.next-dev next dev",
    "dev:clean": "rm -rf .next-dev .next node_modules/.cache && NEXT_DISABLE_WEBPACK_CACHE=1 NEXT_DIST_DIR=.next-dev next dev",
